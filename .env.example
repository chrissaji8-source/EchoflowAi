# Local demo server (use 0.0.0.0 only when you intend to expose it on your network)
HOST=127.0.0.1
PORT=8000
DEBUG=false

# Select "cloud" or "local" for new connections
PIPELINE_MODE=cloud

# Optional cloud chat provider. Leave blank to use the deterministic demo reply.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
LLM_MAX_OUTPUT_TOKENS=1024

# Local chat model; install and start Ollama separately to use it.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Audio thresholds
VAD_SPEECH_THRESHOLD=0.65
DUCKING_VOLUME_RATIO=0.15
